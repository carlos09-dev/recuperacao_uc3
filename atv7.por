programa {
  funcao inicio() {
    cadeia nomeProduto
    inteiro quantidadeProduto
    real precoUnico

    nomeProduto = "camisa social"
    quantidadeProduto = 100
    precoUnico = 60.50

    escreva("Nome do produto: ", nomeProduto, "\n")
    escreva("Quantidade: ", quantidadeProduto, "\n")
    escreva("Preco unico: R$ ", precoUnico)


  }
}
