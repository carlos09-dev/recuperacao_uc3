programa {
  funcao inicio() {
    
cadeia nomeEscola
inteiro quantidadeProfessores
inteiro quantidadeAlunos
real mediaGeral
cadeia atualDiretor

nomeEscola = "Escola Estadual Maria Leite"
quantidadeProfessores = 40
quantidadeAlunos = 300
mediaGeral = 6.0
atualDiretor = "Carlos"

escreva("Nome da escola: ", nomeEscola, "\n")
escreva("Total de professores: ", quantidadeProfessores, "\n")
escreva("Total de alunos: ", quantidadeAlunos, "\n")
escreva("Média geral das notas: ", mediaGeral, "\n")
escreva("Diretor: ", atualDiretor, "\n")
  }
}
