programa {
  funcao inicio() {
cadeia estacao

  escreva("Digite a estacao do ano: ")
  leia(estacao)

  se (estacao == "verao")
  {
      escreva("O verao comeca dia 21 de dezembro.")
  }
  senao se (estacao == "outono")
  {
      escreva("O outono comeca dia 20 de marco.")
  }
  senao se (estacao == "inverno")
  {
      escreva("O inverno comeca dia 21 de junho.")
  }
  senao se (estacao == "primavera")
  {
      escreva("A primavera comeca dia 22 de setembro.")
  }
  senao
  {
      escreva("Estacao invalida!")
  }
  }
}
