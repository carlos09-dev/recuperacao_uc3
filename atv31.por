programa {
  funcao inicio() {
  cadeia tamanho

  escreva("Digite o tamanho da blusa (P, M ou G): ")
  leia(tamanho)

  escolha (tamanho)
  {
    caso "P":
    caso "p":
        escreva("Blusa P: 0.46 x 0.55")
        pare

    caso "M":
    caso "m":
        escreva("Blusa M: 0.51 x 0.56")
        pare

    caso "G":
    caso "g":
        escreva("Blusa G: 0.52 x 0.58")
        pare

    caso contrario:
        escreva("Tamanho invalido!")
  }
  }
}
