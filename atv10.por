programa {
  funcao inicio() {
    cadeia nome
    inteiro idade
    real altura

    escreva("digite seu nome: ")
    leia(nome)
    escreva("digite sua idade: ")
    leia(idade)
    escreva("digite sua altura: ")
    leia(altura)

    escreva("\n")
    escreva("Dados do aluno:\n")
    escreva("Nome: ", nome, "\n")
    escreva("Idade: ", idade, "\n")
    escreva("Altura: ", altura, "\n")

  }
}
