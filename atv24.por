programa {
  funcao inicio() {

cadeia vogal

  escreva("Digite uma vogal: ")
  leia(vogal)

  se (vogal == "a")
  {
      escreva("Arma, Amor, Avião")
  }
  senao se (vogal == "e")
  {
      escreva("Escada, Escola, Elevador")
  }
  senao se (vogal == "i")
  {
      escreva("Islandia, Irlanda, Índio")
  }
  senao se (vogal == "o")
  {
      escreva("Onda, Onça, Óculos")
  }
  senao se (vogal == "u")
  {
      escreva("Universo, Urso, Universidade")
  }
  senao
  {
      escreva("Você não digitou uma vogal.")
  }
}
}
